{
  "name": "webapp",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun --bun ./node_modules/nuxt/bin/nuxt.mjs dev --host localhost --port 3000",
    "api:dev": "bun run --watch index.ts",
    "web:dev": "bun --bun ./node_modules/nuxt/bin/nuxt.mjs dev --host localhost --port 3000",
    "build": "bun --bun ./node_modules/nuxt/bin/nuxt.mjs build",
    "preview": "bun --bun ./node_modules/nuxt/bin/nuxt.mjs preview",
    "nuxt:prepare": "bun --bun ./node_modules/nuxt/bin/nuxt.mjs prepare",
    "db:generate": "bun panda db:generate",
    "db:migrate": "bun panda db:migrate",
    "db:migrate:fresh": "bun panda db:migrate:fresh",
    "db:migrate:rollback": "bun panda db:migrate:rollback",
    "db:migrate:reset": "bun panda db:migrate:reset",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed": "bun panda db:seed",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:feature": "bun test tests/features",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@elysia/bearer": "^1.4.4",
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/opentelemetry": "^1.4.12",
    "@elysiajs/eden": "npm:@elysia/eden@^1.4.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.29",
    "mysql2": "^3.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "nuxt": "^4.4.8",
    "nuxt-elysia": "^0.2.0",
    "typescript": "^5.9"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-prometheus": "0.217.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "esbuild": "0.25.12",
    "protobufjs": "7.6.5"
  },
  "module": "index.ts"
}
